{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "CI",
    "DATABASE_URL",
    "E2E_DATABASE_URL",
    "E2E_MAILPIT_API",
    "E2E_SCREENSHOTS",
    "E2E_WEB_MODE",
    "EDGE_PORT",
    "MAIL_SEND_MODE",
    "NEXT_DIST_DIR",
    "NODE_ENV",
    "SKIP_TEST_INFRA",
    "TEST_DATABASE_URL",
    "WEB_HOST",
    "WEB_PORT",
    "WORKER_PORT"
  ]
}
