# E-Mail-Plattform – environment variables (all validated with Zod in packages/config/src/env.ts).
# Development: run `pnpm setup:env` – it creates .env with freshly generated secrets.
# Never commit real values. Staging/production: GitHub Environments and Docker secrets.

# --- shared ---------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
LOG_LEVEL=info
DATABASE_URL=postgres://emailplattform:<password>@127.0.0.1:54432/emailplattform
VALKEY_URL=redis://127.0.0.1:54379
VALKEY_PREFIX=ep                    # namespaces Valkey keys and BullMQ queues
# Send switch: development sandbox, staging allowlist, production live. Never set live yourself.
MAIL_SEND_MODE=sandbox
MAIL_ALLOWLIST=                     # staging only: a@b.de,@firma.de
# host:port of GreenMail (SMTP, SMTPS) and Mailpit – the only targets in sandbox mode
SANDBOX_MAIL_ENDPOINTS=127.0.0.1:54025,127.0.0.1:54465,127.0.0.1:54102
EMAIL_HASH_KEY=                     # 32 bytes base64, HMAC key for email_hash – never rotated
WEB_URL=http://127.0.0.1:4300
EDGE_URL=http://127.0.0.1:4301

# --- web (apps/web) ------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=4300
BETTER_AUTH_SECRET=                 # at least 32 characters
SEALED_BOX_PUBLIC_KEY=              # X25519 public key of the worker (32 bytes base64)
SYSTEM_MAIL_SMTP_URL=smtp://127.0.0.1:54102   # dev: Mailpit; prod: EU transactional service
SYSTEM_MAIL_FROM="E-Mail-Plattform <no-reply@plattform.test>"
PASSWORD_BREACH_CHECK=on            # off only allowed in development and test
AUTH_RATE_LIMIT=on                  # off only allowed with APP_ENV=test

# --- edge (apps/edge) ----------------------------------------------------
EDGE_HOST=127.0.0.1
EDGE_PORT=4301
EDGE_BUFFER_DIR=.data/edge-buffer

# --- worker (apps/worker) ------------------------------------------------
WORKER_HOST=127.0.0.1
WORKER_PORT=4302
WORKER_QUEUES=                      # empty = all queues; e.g. send,schedule
MASTER_KEY=                         # 32 bytes base64 – worker only, never in the database
MASTER_KEY_VERSION=1
SEALED_BOX_SECRET_KEY=              # X25519 secret key (32 bytes base64) – worker only
STORAGE_DRIVER=fs                   # fs | s3
STORAGE_FS_ROOT=.data/storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ANTHROPIC_API_KEY=
RSPAMD_URL=http://127.0.0.1:54333
CLAMAV_HOST=
CLAMAV_PORT=
CHECK_ADDRESS=pruefadresse@plattform.test   # platform check address for connection tests

# --- local tools, tests and E2E (toolingEnvSchema) -------------------------
DEV_POSTGRES_PASSWORD=
GREENMAIL_API_URL=http://127.0.0.1:54080
MAILPIT_API_URL=http://127.0.0.1:54825
NEXT_DIST_DIR=                      # E2E: .next-e2e
E2E_WEB_MODE=                       # production | dev (default: production in CI, dev locally)
E2E_MAILPIT_API=                    # set by scripts/e2e.ts
E2E_DATABASE_URL=                   # set by scripts/e2e.ts
E2E_SCREENSHOTS=                    # 1 = screenshots of every route in test-results/screens
TEST_DATABASE_URL=                  # set by the Vitest global setup
SKIP_TEST_INFRA=                    # 1 = unit tests without the test stack
